# Required only for conversation, vision, speech, and image generation.
OPENAI_API_KEY=

# Repository location. The default is detected from src/config.py.
EVE_HOME=/home/pi/EVE

# MQTT broker used by the local vision service.
EVE_MQTT_BROKER=aTinozg.local
EVE_MQTT_PORT=1883
EVE_MQTT_TOPIC_PREFIX=eve
EVE_MQTT_USERNAME=
EVE_MQTT_PASSWORD=
EVE_MQTT_TLS=false

# Raspberry Pi hardware overrides.
EVE_I2C_BUS=1
EVE_ESP_ADDRESS=0x77
EVE_SERIAL_PORT=/dev/ttyS0
EVE_SERIAL_BAUDRATE=115200
EVE_CAMERA_SIZE=640

# Optional OpenAI model overrides.
EVE_OPENAI_CHAT_MODEL=gpt-4o
EVE_OPENAI_VISION_MODEL=gpt-4o
EVE_OPENAI_TRANSCRIPTION_MODEL=whisper-1
EVE_OPENAI_SPEECH_MODEL=tts-1
EVE_OPENAI_IMAGE_MODEL=dall-e-2

EVE_LOG_LEVEL=INFO
